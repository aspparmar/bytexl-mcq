Recipe Ingredient List,"**A cooking app needs to store ingredient amounts, but the recipe size varies:**

```c
#include <stdio.h>
#include <stdlib.h>

int main() {
    int ingredient_count = 4;
    double *amounts;
    
    amounts = malloc(ingredient_count * sizeof(double));
    if (amounts == NULL) {
        printf(""Cannot store recipe ingredients\n"");
        return 1;
    }
    
    amounts[0] = 2.5;
    amounts[1] = 1.0;
    amounts[2] = 0.5;
    amounts[3] = 0.25;
    
    printf(""Recipe ingredients:\n"");
    for (int i = 0; i < ingredient_count; i++) {
        printf(""Ingredient %d: %.2f cups\n"", i + 1, amounts[i]);
    }
    
    free(amounts);
    return 0;
}
```

**What is the main advantage of using malloc() for this recipe program?**","malloc() is useful because we don't always know how many ingredients a recipe will have until the program is actually running. Instead of guessing and maybe wasting memory, malloc() lets us ask for exactly the right amount of memory when we need it.",1,published,easy,understand,blank,c-programming,blank,blank,blank,malloc() makes the program run faster than regular arrays,malloc() lets us get exactly the right amount of memory when the program runs,malloc() automatically saves the recipe to a file,malloc() prevents cooking mistakes,2
Game High Scores,"**A game creates a leaderboard with all scores starting at zero:**

```c
#include <stdio.h>
#include <stdlib.h>

int main() {
    int num_players = 5;
    int *high_scores;
    
    high_scores = calloc(num_players, sizeof(int));
    if (high_scores == NULL) {
        printf(""Cannot create leaderboard\n"");
        return 1;
    }
    
    printf(""New leaderboard (all start at zero):\n"");
    for (int i = 0; i < num_players; i++) {
        printf(""Player %d: %d points\n"", i + 1, high_scores[i]);
    }
    
    high_scores[0] = 1500;
    high_scores[2] = 2200;
    high_scores[4] = 1800;
    
    printf(""\nAfter some games:\n"");
    for (int i = 0; i < num_players; i++) {
        printf(""Player %d: %d points\n"", i + 1, high_scores[i]);
    }
    
    free(high_scores);
    return 0;
}
```

**Why might you choose calloc() instead of malloc() for a game leaderboard?**","calloc() is perfect for leaderboards because it automatically fills all memory with zeros. This means every player starts with 0 points without us having to manually set each score. malloc() would leave random garbage values that we'd have to clean up ourselves.",1,published,easy,understand,blank,c-programming,blank,blank,blank,calloc() is always faster than malloc(),"calloc() automatically sets all scores to zero, which is perfect for a fresh leaderboard",calloc() works better with games,calloc() uses less memory than malloc(),2
Playlist Manager,"**A music app needs to expand its playlist as users add more songs:**

```c
#include <stdio.h>
#include <stdlib.h>

int main() {
    int playlist_size = 3;
    int *song_ids = malloc(playlist_size * sizeof(int));
    
    if (song_ids == NULL) {
        printf(""Cannot create playlist\n"");
        return 1;
    }
    
    song_ids[0] = 2001;
    song_ids[1] = 2002;
    song_ids[2] = 2003;
    
    printf(""Current playlist: "");
    for (int i = 0; i < playlist_size; i++) {
        printf(""Song_%d "", song_ids[i]);
    }
    printf(""\n"");
    
    int bigger_size = 6;
    song_ids = realloc(song_ids, bigger_size * sizeof(int));
    
    if (song_ids == NULL) {
        printf(""Cannot expand playlist\n"");
        return 1;
    }
    
    song_ids[3] = 2004;
    song_ids[4] = 2005;
    song_ids[5] = 2006;
    
    printf(""Expanded playlist: "");
    for (int i = 0; i < bigger_size; i++) {
        printf(""Song_%d "", song_ids[i]);
    }
    printf(""\n"");
    
    free(song_ids);
    return 0;
}
```


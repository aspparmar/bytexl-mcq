Puzzle Grid Creator,"**A puzzle game creates a square grid for players to solve:**

```c
#include <stdio.h>
#include <stdlib.h>

int main() {
    int grid_size = 3;
    
    int **puzzle_grid = malloc(grid_size * sizeof(int*));
    if (puzzle_grid == NULL) {
        printf(""Cannot create puzzle grid\n"");
        return 1;
    }
    
    for (int row = 0; row < grid_size; row++) {
        puzzle_grid[row] = malloc(grid_size * sizeof(int));
        if (puzzle_grid[row] == NULL) {
            printf(""Cannot create row %d\n"", row);
            return 1;
        }
    }
    
    int number = 1;
    for (int i = 0; i < grid_size; i++) {
        for (int j = 0; j < grid_size; j++) {
            puzzle_grid[i][j] = number++;
        }
    }
    
    printf(""Puzzle grid:\n"");
    for (int i = 0; i < grid_size; i++) {
        for (int j = 0; j < grid_size; j++) {
            printf(""%d "", puzzle_grid[i][j]);
        }
        printf(""\n"");
    }
    
    for (int i = 0; i < grid_size; i++) {
        free(puzzle_grid[i]);
    }
    free(puzzle_grid);
    
    return 0;
}
```

**To create a square grid with dynamic memory, what's the process?**","Creating a dynamic grid is like building a bookcase: first you build the frame that will hold the shelves (array of pointers), then you add each shelf one by one (each row). This two-step process gives you a flexible grid where each row could even be a different size if needed.",1,published,medium,understand,blank,c-programming,blank,blank,blank,Use one malloc() call for the entire grid,"First make an array of row pointers, then make each row separately",Use calloc() which creates grids automatically,"Create all rows first, then connect them",2
Memory Waste Demonstration,"**A program shows what happens when you forget to clean up memory:**

```c
#include <stdio.h>
#include <stdlib.h>

void messy_function() {
    int *data = malloc(8 * sizeof(int));
    if (data == NULL) {
        printf(""Cannot get memory\n"");
        return;
    }
    
    for (int i = 0; i < 8; i++) {
        data[i] = i * 3;
    }
    
    printf(""Messy function created: "");
    for (int i = 0; i < 8; i++) {
        printf(""%d "", data[i]);
    }
    printf(""\n"");
}

void clean_function() {
    int *data = malloc(8 * sizeof(int));
    if (data == NULL) {
        printf(""Cannot get memory\n"");
        return;
    }
    
    for (int i = 0; i < 8; i++) {
        data[i] = i * 4;
    }
    
    printf(""Clean function created: "");
    for (int i = 0; i < 8; i++) {
        printf(""%d "", data[i]);
    }
    printf(""\n"");
    
    free(data);
}

int main() {
    printf(""Running messy function:\n"");
    messy_function();
    
    printf(""Running clean function:\n"");
    clean_function();
    
    return 0;
}
```

**What's wrong with the messy_function()?**","The messy function gets memory with malloc() but never gives it back with free(). This means the memory stays ""reserved"" for the program even though it's not being used anymore. If a program does this many times, it can waste all the computer's memory - this is called a ""memory leak.""",1,published,easy,understand,blank,c-programming,blank,blank,blank,It uses too much memory,"It doesn't call free(), so the memory stays reserved and wasted",It has too many variables,It prints too much information,2
Careful Programming Example,"**A program shows the proper way to handle memory safely:**

```c
#include <stdio.h>
#include <stdlib.h>

int main() {
    int data_size = 6;
    float *measurements = malloc(data_size * sizeof(float));
    
    if (measurements == NULL) {
        printf(""Error: Could not get memory for measurements\n"");
        return 1;
    }
    
    printf(""Memory allocation successful!\n"");
    
    for (int i = 0; i < data_size; i++) {
        measurements[i] = i * 2.5;
    }
    
    printf(""Measurements: "");
    for (int i = 0; i < data_size; i++) {
        printf(""%.1f "", measurements[i]);
    }
    printf(""\n"");
    
    free(measurements);
    measurements = NULL;
    
    printf(""Memory properly freed and pointer cleared\n"");
    
    return 0;
}
```

**What are the essential rules for safe memory management?**","Safe memory management follows 4 simple rules: 1) Check if malloc/calloc returned NULL (failed), 2) Stay within the memory boundaries you requested, 3) Call free() when you're finished, 4) Set the pointer to NULL so you can't accidentally use the freed memory. Following these rules prevents crashes and memory waste.",1,published,medium,understand,blank,c-programming,blank,blank,blank,Always use the maximum amount of memory available,"Check if allocation worked, use memory carefully, free it when done, clear the pointer","Only use malloc(), never calloc() or realloc()","Never check if malloc() worked - assume it always succeeds",2
Smart List Growing,"**A shopping list program shows how to safely expand arrays:**

```c
#include <stdio.h>
#include <stdlib.h>

int main() {
    int list_size = 3;
    int *item_prices = malloc(list_size * sizeof(int));
    
    if (item_prices == NULL) {
        printf(""Cannot create shopping list\n"");
        return 1;
    }
    
    item_prices[0] = 12;
    item_prices[1] = 8;
    item_prices[2] = 15;
    
    printf(""Initial shopping list: "");
    for (int i = 0; i < list_size; i++) {
        printf(""$%d "", item_prices[i]);
    }
    printf(""\n"");
    
    int new_size = 6;
    int *expanded_list = realloc(item_prices, new_size * sizeof(int));
    
    if (expanded_list == NULL) {
        printf(""Cannot expand list - keeping original\n"");
        free(item_prices);
        return 1;
    }
    
    item_prices = expanded_list;
    
    item_prices[3] = 6;
    item_prices[4] = 20;
    item_prices[5] = 4;
    
    printf(""Complete shopping list: "");
    for (int i = 0; i < new_size; i++) {
        printf(""$%d "", item_prices[i]);
    }
    printf(""\n"");
    
    free(item_prices);
    return 0;
}
```

**Why do we use a separate variable (expanded_list) with realloc()?**","Using a separate variable is a safety trick. If realloc() fails, it returns NULL. If we put that NULL directly into our original pointer, we'd lose the address of our original memory and couldn't free it! The separate variable lets us check if realloc() worked before updating our main pointer.",1,published,medium,apply,blank,c-programming,blank,blank,blank,realloc() requires a separate variable to work,"If realloc() fails, we can still free the original memory",It makes the program faster,It's just a programming style choice,2
Text Message Manager,"**A messaging app handles multiple text messages of different lengths:**

```c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int main() {
    char msg1[] = ""Hello!"";
    char msg2[] = ""How are you doing today?"";
    char msg3[] = ""See you later!"";
    
    char *message1 = malloc(strlen(msg1) + 1);
    char *message2 = malloc(strlen(msg2) + 1);
    char *message3 = malloc(strlen(msg3) + 1);
    
    if (message1 == NULL || message2 == NULL || message3 == NULL) {
        printf(""Cannot store all messages\n"");
        free(message1);
        free(message2);
        free(message3);
        return 1;
    }
    
    strcpy(message1, msg1);
    strcpy(message2, msg2);
    strcpy(message3, msg3);
    
    printf(""Text conversation:\n"");
    printf(""Message 1: %s\n"", message1);
    printf(""Message 2: %s\n"", message2);
    printf(""Message 3: %s\n"", message3);
    
    free(message1);
    free(message2);
    free(message3);
    
    printf(""All messages cleaned up\n"");
    
    return 0;
}
```

**When you have several separate memory allocations, what's important to remember?**","Every single malloc() or calloc() call must have its own matching free() call. If you allocate 3 separate pieces of memory, you need 3 separate free() calls. Each allocation is independent - think of them as separate containers that each need to be returned individually.",1,published,easy,apply,blank,c-programming,blank,blank,blank,Free them all with one free() call,Each malloc() needs its own matching free() call,Only free the largest allocation,The order of freeing must match the order of allocation,2
Complete Store Inventory,"**A store management program demonstrates all memory management concepts together:**

```c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int main() {
    printf(""Store Inventory System\n"");
    
    int item_count = 4;
    int *stock_levels = calloc(item_count, sizeof(int));
    
    if (stock_levels == NULL) {
        printf(""Cannot create inventory system\n"");
        return 1;
    }
    
    char *item_a = malloc(strlen(""Laptops"") + 1);
    char *item_b = malloc(strlen(""Phones"") + 1);
    char *item_c = malloc(strlen(""Tablets"") + 1);
    char *item_d = malloc(strlen(""Watches"") + 1);
    
    if (item_a == NULL || item_b == NULL || item_c == NULL || item_d == NULL) {
        printf(""Cannot allocate item names\n"");
        free(stock_levels);
        free(item_a);
        free(item_b);
        free(item_c);
        free(item_d);
        return 1;
    }
    
    strcpy(item_a, ""Laptops"");
    strcpy(item_b, ""Phones"");
    strcpy(item_c, ""Tablets"");
    strcpy(item_d, ""Watches"");
    
    stock_levels[0] = 25;
    stock_levels[1] = 40;
    stock_levels[2] = 15;
    stock_levels[3] = 30;
    
    printf(""\nCurrent store inventory:\n"");
    printf(""%s: %d units\n"", item_a, stock_levels[0]);
    printf(""%s: %d units\n"", item_b, stock_levels[1]);
    printf(""%s: %d units\n"", item_c, stock_levels[2]);
    printf(""%s: %d units\n"", item_d, stock_levels[3]);
    
    int new_count = 6;
    int *new_stock = realloc(stock_levels, new_count * sizeof(int));
    
    if (new_stock == NULL) {
        printf(""Cannot expand inventory\n"");
    } else {
        stock_levels = new_stock;
        stock_levels[4] = 20;
        stock_levels[5] = 10;
        printf(""\nExpanded inventory includes:\n"");
        printf(""Headphones: %d units\n"", stock_levels[4]);
        printf(""Speakers: %d units\n"", stock_levels[5]);
    }
    
    free(stock_levels);
    free(item_a);
    free(item_b);
    free(item_c);
    free(item_d);
    
    printf(""\nStore closed - all inventory memory cleaned up\n"");
    
    return 0;
}
```


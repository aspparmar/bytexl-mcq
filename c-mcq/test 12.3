Dictionary Lookup,"**A dictionary application searches for word definitions:**

```c
#include <stdio.h>
#include <string.h>

int main() {
    FILE *dictionary;
    char word[30], definition[100];
    char search_word[] = ""algorithm"";
    
    dictionary = fopen(""words.txt"", ""r"");
    if(dictionary != NULL) {
        while(fscanf(dictionary, ""%s %[^\n]"", word, definition) == 2) {
            if(strcmp(word, search_word) == 0) {
                printf(""Found: %s - %s\n"", word, definition);
                break;
            }
        }
        fclose(dictionary);
    }
    
    return 0;
}
```


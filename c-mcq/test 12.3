Text File Splitter,"**A command-line utility splits text files:**

```c
#include <stdio.h>

int main(int argc, char *argv[]) {
    FILE *input, *output1, *output2;
    char line[150];
    int line_count = 0;
    
    if(argc != 4) {
        printf(""Usage: %s <input_file> <output1> <output2>\n"", argv[0]);
        return 1;
    }
    
    input = fopen(argv[1], ""r"");
    output1 = fopen(argv[2], ""w"");
    output2 = fopen(argv[3], ""w"");
    
    if(input != NULL && output1 != NULL && output2 != NULL) {
        while(fgets(line, sizeof(line), input) != NULL) {
            if(line_count % 2 == 0) {
                fputs(line, output1);
            } else {
                fputs(line, output2);
            }
            line_count++;
        }
        printf(""File split completed\n"");
    }
    
    if(input) fclose(input);
    if(output1) fclose(output1);
    if(output2) fclose(output2);
    
    return 0;
}
```

**What does this command-line utility accomplish?**","The program reads lines from input and distributes them alternately: even-numbered lines (0,2,4...) go to output1, odd-numbered lines (1,3,5...) go to output2.",1,published,hard,analyze,blank,c-programming,blank,blank,blank,It merges two files into one larger file,It alternates lines between two output files,It compares the contents of two files,It creates backup copies of important files,2

Survey Result Analyzer,"**A survey analysis tool processes customer feedback:**

```c
#include <stdio.h>

int main() {
    FILE *responses, *analysis;
    int rating, total = 0, count = 0;
    int ratings[6] = {0};
    
    responses = fopen(""survey_data.txt"", ""r"");
    analysis = fopen(""survey_analysis.txt"", ""w"");
    
    if(responses != NULL && analysis != NULL) {
        while(fscanf(responses, ""%d"", &rating) == 1) {
            if(rating >= 1 && rating <= 5) {
                ratings[rating]++;
                total += rating;
                count++;
            }
        }
        
        fprintf(analysis, ""Average Rating: %.2f\n"", (float)total/count);
        fprintf(analysis, ""5-star reviews: %d\n"", ratings[5]);
    }
    
    if(responses) fclose(responses);
    if(analysis) fclose(analysis);
    
    return 0;
}
```

